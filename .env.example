# AI provider: "none" (default, fully offline), "anthropic", or "ollama"
AI_PROVIDER=none

# Anthropic (server-side only — never exposed to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# ── Local single-user mode (default) ─────────────────────────────
# No login. Optional: override the SQLite database location.
# FRANCAIS_DB_PATH=./data/french.db

# ── Logins + one database per learner (required when hosted) ─────
# Leave APP_USERS unset to stay in local single-user mode.
# APP_USERS=sahit,partner
# SESSION_SECRET=            # 32+ random characters (npm run hash-password prints one)
#
# For each id in APP_USERS (upper-case, "-" becomes "_"):
# USER_SAHIT_NAME=Sahit                          # optional display name; also accepted at login
# USER_SAHIT_PASSWORD_HASH=scrypt:16384:8:1:…    # from: npm run hash-password
# USER_SAHIT_DB_URL=libsql://petit-sahit-<org>.turso.io   # locally defaults to file:data/sahit.db
# USER_SAHIT_DB_TOKEN=                           # Turso database token
