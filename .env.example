# Learners can add their own Anthropic key in Settings → AI tutor (stored encrypted).
# Its encryption secret: AI_KEY_SECRET, else SESSION_SECRET, else (local only) data/ai-secret.key.
# AI_KEY_SECRET=                                    # optional, 32+ random characters
#
# Server-wide AI provider (used by learners without their own key):
# "none" (default, fully offline), "anthropic", or "ollama"
AI_PROVIDER=none

# Anthropic (server-side only — never exposed to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# ── Local single-user mode (default) ─────────────────────────────
# No login. Optional: override the SQLite database location.
# FRANCAIS_DB_PATH=./data/french.db
# FRANCAIS_LANG=de                                  # local learner studies German (data/de.db)

# ── Accounts: sign-up + one database per learner (always on when hosted) ──
# Leave ACCOUNTS_DB_URL unset to stay in local single-user mode.
# SESSION_SECRET=                                   # 32+ random characters: npm run session-secret
# ACCOUNTS_DB_URL=libsql://petit-accounts-<org>.turso.io   # locally e.g. data/accounts.db
# ACCOUNTS_DB_TOKEN=                                # Turso token for the accounts database
#
# Creates each new learner's Turso database at sign-up. Without these (local only),
# learners' databases are files next to the accounts database: data/<username>.db
# TURSO_API_TOKEN=                                  # Turso Platform API token
# TURSO_ORG=                                        # Turso organization slug
# TURSO_GROUP=default                               # optional
#
# SIGNUPS=closed                                    # optional: turn sign-up off
